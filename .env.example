# --- Required (put real values in .env, never commit it) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resumeverify?schema=public
GEMINI_API_KEY=
GITHUB_TOKEN=
JWT_SECRET=

# --- Optional (defaults shown) ---
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# API_PORT=4000
# WEB_ORIGIN=http://localhost:3000
# API_URL=http://localhost:4000   # used by the web server to proxy /api
# Optional: extra Gemini keys (comma-separated). Calls rotate across GEMINI_API_KEY + these when one hits its quota.
# GEMINI_API_KEYS=
